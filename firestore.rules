rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- Validation Blueprints ---
    
    function isValidProfile(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('learningStyle' in data) || (data.learningStyle in ['beginner', 'intermediate', 'advanced']))
        && (!('streak' in data) || (data.streak is int && data.streak >= 0))
        && (!('totalStudyMinutes' in data) || (data.totalStudyMinutes is int && data.totalStudyMinutes >= 0));
    }

    function isValidGoal(data) {
      return data.keys().hasAll(['userId', 'title', 'status'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.status in ['pending', 'in-progress', 'completed']
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    function isValidNote(data) {
      return data.keys().hasAll(['userId', 'title', 'content'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 50000;
    }

    function isValidQuiz(data) {
      return data.keys().hasAll(['userId', 'topic', 'questions'])
        && data.userId == request.auth.uid
        && data.topic is string && data.topic.size() <= 200
        && data.questions is list && data.questions.size() <= 50;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['userId', 'duration'])
        && data.userId == request.auth.uid
        && data.duration is int && data.duration >= 0;
    }

    function isValidQuizAttempt(data) {
      return data.keys().hasAll(['userId', 'correctCount', 'totalQuestions', 'timestamp'])
        && data.userId == request.auth.uid
        && data.correctCount is int
        && data.totalQuestions is int
        && data.timestamp == request.time;
    }

    // --- Collections ---

    match /profiles/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfile(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidProfile(incoming()) 
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
    }

    match /quiz_attempts/{attemptId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(attemptId) && isValidQuizAttempt(incoming());
    }

    match /goals/{goalId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(goalId) && isValidGoal(incoming()) && incoming().createdAt == request.time;
      allow update: if isVerified() && isOwner(existing().userId) && isValidGoal(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified() && isOwner(existing().userId);
    }

    match /notes/{noteId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(noteId) && isValidNote(incoming()) && incoming().createdAt == request.time;
      allow update: if isVerified() && isOwner(existing().userId) && isValidNote(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerified() && isOwner(existing().userId);
    }

    match /quizzes/{quizId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(quizId) && isValidQuiz(incoming()) && incoming().createdAt == request.time;
      allow delete: if isVerified() && isOwner(existing().userId);
    }

    match /sessions/{sessionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(sessionId) && isValidSession(incoming()) && incoming().startTime == request.time;
      allow delete: if isVerified() && isOwner(existing().userId);
    }
  }
}
